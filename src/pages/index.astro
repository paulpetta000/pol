---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Flag from '../components/Flag.astro';
import HeroArt from '../components/HeroArt.astro';
import Countdown from '../components/Countdown.astro';
import Timeline2027 from '../components/Timeline2027.astro';
import Avvisami from '../components/Avvisami.astro';
import Fatto from '../components/Fatto.astro';
import Mappa from '../components/Mappa.astro';
import FontiPagina from '../components/FontiPagina.astro';
import { getCollection } from 'astro:content';
import { getFatti } from '../lib/fatti';
import { testoRicco, dataBreve } from '../lib/formato';
import { SITO } from '../config/sito';
import R from '../data/risultati-2026.json';

const f = await getFatti(['cal-lvc-periodo', 'cal-match', 'cal-flotta', 'big-niente', 'sq-sette', 'res-napoli', 'vista-vicino']);
const squadre = (await getCollection('squadre')).sort((a, b) => a.data.ordine - b.data.ordine);
const faq = (await getCollection('faq')).filter(q => ['quando', 'gratis', 'dove-meglio', 'biglietti', 'tv'].includes(q.id));

const AZIONI = [
  { href: '/come-vederla/dal-lungomare/', icon: 'binocolo', t: 'Vederla gratis', s: 'dal lungomare e dalle colline' },
  { href: '/come-vederla/dal-mare/', icon: 'barca', t: 'Vederla dal mare', s: 'con la tua barca o in gita' },
  { href: '/come-vederla/biglietti-e-ospitalita/', icon: 'biglietto', t: 'Biglietti e ospitalità', s: 'tribune, pacchetti, avvisi' },
  { href: '/calendario/', icon: 'calendario', t: 'Date e orari', s: '22 maggio – 19 luglio' },
  { href: '/napoli/come-arrivare/', icon: 'percorso', t: 'Come arrivare', s: 'aereo, treno, metro, taxi' },
  { href: '/squadre/', icon: 'bandiera', t: 'Chi gareggia', s: '7 squadre, 6 sfidanti' }
] as const;
const podio = R.napoli.classifica.slice(0, 3);
---
<Base
  title="Guida non ufficiale all'America's Cup di Napoli 2027"
  description="Come vedere l'America's Cup a Napoli nel 2027: date dal 22 maggio al 19 luglio, dove guardare gratis dal lungomare, regole per le barche, biglietti, trasporti e squadre. Ogni informazione con fonte."
>
  <section class="hero">
    <HeroArt />
    <div class="wrap hero__in">
      <p class="hero__meta mono">Guida non ufficiale · controllata il {dataBreve(SITO.aggiornato)}</p>
      <h1>L'America's Cup è a Napoli</h1>
      <p class="hero__date"><span class="num">22.05 → 19.07.2027</span> Regate nel golfo, davanti al lungomare</p>
      <Countdown al="2027-05-22" testo="alla prima regata" grande />
    </div>
  </section>

  <section class="section cosa" aria-labelledby="cosa-h">
    <div class="wrap">
      <h2 id="cosa-h" class="cosa__h">Cosa vuoi fare?</h2>
      <ul class="azioni">
        {AZIONI.map((a, i) => (
          <li>
            <a href={a.href} class="azione">
              <span class="azione__n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="azione__ico"><Icon name={a.icon} size={30} /></span>
              <span class="azione__t">{a.t}</span>
              <span class="azione__s">{a.s}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="prossimo-h">
    <div class="wrap split">
      <div>
        <p class="kicker">Prossimo appuntamento</p>
        <h2 id="prossimo-h">Sabato 22 maggio 2027: 7 AC75 sulla stessa linea di partenza</h2>
        <p class="lead">Si apre la Louis Vuitton Cup con due giorni di regate di flotta. Poi duelli, semifinali, finale e dal 10 luglio il Match per la Coppa.</p>
        <p class="btn-row"><a class="btn btn--primary" href="/calendario/"><Icon name="calendario" size={20} /> Tutte le date</a><a class="btn" href="/calendario/#iscriviti">Aggiungi al tuo calendario</a></p>
      </div>
      <div class="stack">
        <Timeline2027 compatta />
        <ul class="fatti">
          <Fatto f={f.get('cal-flotta')!} />
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="dove-h">
    <div class="wrap split">
      <div>
        <p class="kicker">Dove guardare</p>
        <h2 id="dove-h">In prima fila sul lungomare, o dall'alto</h2>
        <p>{f.get('vista-vicino')!.data.testo} Otto punti da cui guardare, con sole, gradini e folla: scegli il tuo.</p>
        <p class="btn-row"><a class="btn btn--primary" href="/napoli/mappa/"><Icon name="mappa" size={20} /> Apri la mappa</a><a class="btn" href="/come-vederla/dal-lungomare/">Consigli per il lungomare</a></p>
      </div>
      <a href="/napoli/mappa/" class="map-link" aria-label="Apri la mappa completa">
        <Mappa anteprima id="mappa-home" />
      </a>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <Avvisami />
    </div>
  </section>

  <section class="section" aria-labelledby="sq-h">
    <div class="wrap">
      <p class="kicker">Chi gareggia</p>
      <h2 id="sq-h">7 squadre, una sola Coppa</h2>
      <ul class="sq-strip">
        {squadre.map(s => (
          <li>
            <a href={`/squadre/${s.id}/`}>
              <Flag code={s.data.bandiera} width={34} decorative />
              <span class="sq-strip__n">{s.data.nome}</span>
              <span class="sq-strip__r mono">{s.data.ruolo === 'defender' ? 'Defender' : s.data.ruolo === 'challenger-of-record' ? 'Challenger of Record' : 'Sfidante'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="arch-h">
    <div class="wrap split">
      <div>
        <p class="kicker">Archivio 2026</p>
        <h2 id="arch-h">Napoli 2026: vince Luna Rossa</h2>
        <p>{f.get('res-napoli')!.data.testo}</p>
        <p><a class="btn" href="/archivio-2026/"><Icon name="trofeo" size={20} /> Risultati di Napoli e Cagliari</a></p>
      </div>
      <ol class="podio">
        {podio.map(r => (
          <li><span class="podio__pos num">{r.pos}</span><span class="podio__n">{r.barca}</span><span class="podio__p num">{r.punti} pt</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap">
      <p class="kicker">Domande frequenti</p>
      <h2 id="faq-h">Le risposte veloci</h2>
      <div class="faq-mini">
        {faq.map(q => (
          <details>
            <summary>{q.data.domanda}</summary>
            <p set:html={testoRicco(q.data.risposta)} />
          </details>
        ))}
      </div>
      <p><a href="/domande-frequenti/">Tutte le domande →</a></p>
    </div>
  </section>

  <FontiPagina fatti={f.values()} />
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); min-height: clamp(26rem, 70vh, 38rem); display: flex; align-items: flex-start; }
  .hero__in { position: relative; z-index: 1; padding-top: clamp(2rem, 6vw, 4.5rem); padding-bottom: 13rem; }
  @media (min-width: 900px) { .hero__in { padding-bottom: 5rem; } .hero h1, .hero__date, .hero :global(.countdown) { max-width: 34rem; } }
  .hero__meta { font-size: .74rem; color: var(--ink-3); letter-spacing: .05em; text-transform: uppercase; margin-bottom: 1rem; }
  .hero h1 { max-width: 11ch; margin-bottom: .6rem; }
  .hero__date { display: flex; flex-wrap: wrap; gap: .3rem .8rem; align-items: baseline; font-size: 1.12rem; color: var(--ink-2); margin-bottom: 1.2rem; }
  .hero__date .num { font-size: 1.05rem; font-weight: 600; color: var(--ink); background: var(--buoy); color: #0F1519; padding: .05rem .4rem; border-radius: 2px; }
  .cosa__h { font-size: clamp(1.9rem, 1.3rem + 2.6vw, 2.9rem); }
  .azioni { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .azioni li { margin: 0; }
  .azione { position: relative; display: flex; flex-direction: column; gap: .15rem; height: 100%; min-height: 8.2rem; padding: .9rem .9rem 1rem; border: 2px solid var(--ink); border-radius: var(--r); background: var(--surface); color: var(--ink); text-decoration: none; transition: background-color .15s, color .15s, transform .15s; }
  .azione:hover { background: var(--ink); color: var(--bg); }
  .azione:hover .azione__ico { color: var(--accent); }
  .azione:active { transform: translateY(1px); }
  .azione__n { position: absolute; top: .55rem; right: .7rem; font-size: .7rem; color: var(--ink-3); }
  .azione__ico { color: var(--accent); margin-bottom: auto; padding-bottom: .6rem; }
  .azione__t { font-weight: 800; font-stretch: 78%; font-size: 1.28rem; line-height: 1.05; }
  .azione__s { font-size: .86rem; color: inherit; opacity: .78; line-height: 1.25; }
  @media (min-width: 760px) { .azioni { grid-template-columns: repeat(3, 1fr); gap: .8rem; } .azione { min-height: 9.5rem; padding: 1.1rem; } .azione__t { font-size: 1.5rem; } }
  .map-link { display: block; text-decoration: none; }
  .map-link:hover :global(.mappa) { border-color: var(--accent); }
  .sq-strip { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); border-top: 2px solid var(--ink); }
  .sq-strip li { margin: 0; border-bottom: 1px solid var(--line); }
  .sq-strip a { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: .8rem; align-items: center; padding: .85rem .2rem; color: var(--ink); text-decoration: none; }
  .sq-strip a:hover { background: var(--bg-2); }
  .sq-strip :global(.flag) { grid-row: 1 / 3; }
  .sq-strip__n { font-weight: 750; font-stretch: 86%; font-size: 1.08rem; line-height: 1.1; }
  .sq-strip__r { font-size: .7rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
  .podio { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .podio li { display: grid; grid-template-columns: 2.6rem 1fr auto; align-items: center; gap: .6rem; padding: .8rem 0; border-bottom: 1px solid var(--line); margin: 0; }
  .podio__pos { font-size: 1.7rem; color: var(--accent); font-weight: 600; }
  .podio__n { font-weight: 750; font-stretch: 86%; font-size: 1.15rem; }
  .faq-mini { border-top: 2px solid var(--ink); margin: 1rem 0; }
  .faq-mini details { border-bottom: 1px solid var(--line); }
  .faq-mini summary { cursor: pointer; padding: 1rem 2rem 1rem 0; font-weight: 750; font-stretch: 88%; font-size: 1.1rem; list-style: none; position: relative; }
  .faq-mini summary::-webkit-details-marker { display: none; }
  .faq-mini summary::after { content: '+'; position: absolute; right: .2rem; top: .8rem; font: 500 1.4rem var(--f-mono); color: var(--accent); }
  .faq-mini details[open] summary::after { content: '−'; }
  .faq-mini details p { margin: 0 0 1rem; color: var(--ink-2); }
</style>
