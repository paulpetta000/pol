---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FontiPagina from '../components/FontiPagina.astro';
import Testo from '../components/Testo.astro';
import { getCollection } from 'astro:content';
import { getTesti } from '../lib/testi';

const T = await getTesti('domande-frequenti');
const faq = (await getCollection('faq')).map(q => ({ q, b: T.b(q.id) }));
// Ogni risposta deve avere la sua domanda in src/data/faq.yaml
const senzaDomanda = T.blocchi.filter(n => !faq.some(x => x.q.id === n));
if (senzaDomanda.length) throw new Error(`Risposte senza domanda in src/data/faq.yaml: ${senzaDomanda.join(', ')}`);
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(({ q, b }) => ({ '@type': 'Question', name: q.data.domanda, acceptedAnswer: { '@type': 'Answer', text: b.nudo } }))
}];
---
<Base title="Domande frequenti sull'America's Cup a Napoli" description="Risposte brevi: quando si corre, se si vede gratis, dove guardare, biglietti, TV, barche, trasporti, bambini e accessibilità. America's Cup 2027 a Napoli." jsonld={jsonld}>
  <PageHead kicker="Domande frequenti" title="Domande frequenti" lead={`${faq.length} risposte brevi. Le fonti sono in fondo alla pagina.`} />
  <section class="section">
    <div class="wrap">
      <div class="faq">
        {faq.map(({ q, b }) => (
          <details id={q.id}>
            <summary>{q.data.domanda}</summary>
            <Testo b={b} class="faq__r" />
          </details>
        ))}
      </div>
    </div>
  </section>
  <FontiPagina testi={T} />
</Base>
<style>
  .faq { border-top: 2px solid var(--ink); }
  .faq details { border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--head-h) + 12px); }
  .faq summary { cursor: pointer; padding: 1.05rem 2.2rem 1.05rem 0; font-weight: 750; font-stretch: 88%; font-size: 1.15rem; list-style: none; position: relative; line-height: 1.25; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: .3rem; top: .85rem; font: 500 1.5rem var(--f-mono); color: var(--accent); }
  .faq details[open] summary::after { content: '−'; }
  .faq :global(.faq__r) { padding-bottom: 1rem; }
</style>
