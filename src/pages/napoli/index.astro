---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Mappa from '../../components/Mappa.astro';
import Testo from '../../components/Testo.astro';
import FontiPagina from '../../components/FontiPagina.astro';
import { getTesti } from '../../lib/testi';

const T = await getTesti('napoli');
const PAGINE = [
  { href: '/napoli/mappa/', icon: 'mappa', t: 'Mappa', s: 'Punti da cui guardare, stazioni, villaggi' },
  { href: '/napoli/itinerari/', icon: 'pin', t: 'Itinerari a Napoli', s: 'Mezza giornata, 1, 2 e 3 giorni, o componi il tuo' },
  { href: '/napoli/dove-mangiare/', icon: 'piatto', t: 'Dove mangiare', s: 'Pizzerie, trattorie, pesce, friggitorie, dolci e caffè' },
  { href: '/napoli/come-arrivare/', icon: 'percorso', t: 'Come arrivare e muoversi', s: 'Aereo, treno, taxi a prezzo fisso, metro' },
  { href: '/napoli/accessibilita/', icon: 'accessibilita', t: 'Accessibilità', s: 'Pedane, ascensori, assistenza' }
] as const;
---
<Base title="Napoli durante l'America's Cup: mappa, itinerari, trasporti" description="Muoversi a Napoli durante l'America's Cup 2027: mappa del lungomare, itinerari in città, come arrivare dall'aeroporto e dalla stazione, metro e funicolari, accessibilità.">
  <PageHead kicker="Napoli" title="Napoli, istruzioni per l'uso" lead="Nei giorni di regata conviene muoversi a piedi e con metro e funicolari, non in auto. Qui trovi mappa, itinerari, trasporti e accessibilità." />
  <section class="section">
    <div class="wrap split">
      <div>
        <ul class="vai">
          {PAGINE.map(p => (
            <li><a href={p.href}><span class="vai__icona"><Icon name={p.icon} /></span><span><span class="vai__titolo">{p.t}</span><span class="vai__sotto">{p.s}</span></span><span class="vai__freccia"><Icon name="freccia" /></span></a></li>
          ))}
        </ul>
        <h2 class="mt">Da sapere prima di partire</h2>
        <Testo b={T.b('prima-di-partire')} />
      </div>
      <a href="/napoli/mappa/" class="map-link"><span class="visually-hidden">Apri la mappa completa</span><Mappa anteprima id="mappa-napoli" /></a>
    </div>
  </section>
  <FontiPagina testi={T} />
</Base>
<style>
  .mt { margin-top: 2rem; }
  .map-link { display: block; }
</style>
