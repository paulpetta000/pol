---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Testo from '../../components/Testo.astro';
import Avvisami from '../../components/Avvisami.astro';
import FontiPagina from '../../components/FontiPagina.astro';
import { getTesti } from '../../lib/testi';

const T = await getTesti('napoli-accessibilita');
---
<Base title="America's Cup a Napoli: accessibilità" description="Vedere l'America's Cup a Napoli con una disabilità: pedane accessibili sugli scogli nel 2026, lungomare in piano, ascensore di Monte Echia. Servizi 2027 non ancora annunciati.">
  <PageHead kicker="Napoli · accessibilità" title="Accessibilità" lead="Il lungomare è in piano e senza gradini: è il posto più comodo per chi si muove in carrozzina. Per il 2027 i servizi dedicati non sono ancora stati annunciati." crumbs={[{ href: '/napoli/', label: 'Napoli' }]} />
  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Cosa si sa</h2>
        <Testo b={T.b('cosa-si-sa')} />
      </div>
      <div class="stack">
        <div class="terzo">
          <h3><Icon name="accessibilita" size={22} /> I nostri consigli</h3>
          <ul>
            <li>Via Caracciolo, via Partenope e il ponte di Castel dell'Ovo sono in piano.</li>
            <li>Le colline (Vomero, Posillipo) hanno salite e scale: controlla prima ascensori e funicolari.</li>
            <li>Arriva presto: le pedane e i posti in prima fila si riempiono per primi.</li>
            <li>Prima di partire controlla sul sito dell'azienda dei trasporti che gli ascensori delle stazioni funzionino.</li>
          </ul>
        </div>
        <Avvisami titolo="Avvisami quando escono i servizi 2027" predefinito={['village']} />
      </div>
    </div>
  </section>
  <FontiPagina testi={T} />
</Base>
