---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Illustrazione from '../../components/Illustrazione.astro';
import Testo from '../../components/Testo.astro';
import FontiPagina from '../../components/FontiPagina.astro';
import { getTesti } from '../../lib/testi';

const T = await getTesti('come-arrivare');
// Tabella delle tariffe: «Da → A» e prezzo (src/testi/come-arrivare.yaml#tariffe)
const TAXI = T.b('tariffe').voci.map(v => { const [da, a] = v.html.split(' → '); return { da, a, p: v.num }; });
---
<Base title="Come arrivare al lungomare di Napoli per l'America's Cup" description="Dall'aeroporto e dalla stazione al lungomare di Napoli: taxi a tariffa fissa (21, 24, 28,50 €), taxi collettivo, metro Linea 6 e 1, funicolari. Cosa si sa per il 2027.">
  <PageHead illustrazione="taxi" kicker="Napoli · trasporti" title="Come arrivare e muoversi" lead="Regola numero uno: niente auto. Dall'aeroporto il taxi ha tariffe fisse; in città metro e funicolari ti portano a pochi passi dal lungomare." crumbs={[{ href: '/napoli/', label: 'Napoli' }]} />

  <section class="section" aria-labelledby="aereo-h">
    <div class="wrap split">
      <div>
        <p class="kicker"><Icon name="aereo" size={16} /> Dall'aeroporto</p>
        <h2 id="aereo-h">Taxi a tariffa fissa</h2>
        <Testo b={T.b('taxi')} />
        <div class="tabella-wrap" tabindex="0" role="region" aria-label="Tariffe fisse dei taxi">
          <table>
            <caption class="visually-hidden">Tariffe fisse dei taxi di Napoli</caption>
            <thead><tr><th scope="col">Da</th><th scope="col">A</th><th scope="col" class="num">Euro</th></tr></thead>
            <tbody>{TAXI.map(t => <tr><td set:html={t.da} /><td set:html={t.a} /><td class="num mono">{t.p}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      <div>
        <Testo b={T.b('aereo-altro')} />
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="citta-h">
    <div class="wrap">
      <Illustrazione nome="metro" size={130} class="illu-dx" />
      <p class="kicker"><Icon name="treno" size={16} /> In città</p>
      <h2 id="citta-h">Metro e funicolari fino al lungomare</h2>
      <div class="grid-2 grid-2--testi">
        <Testo b={T.b('linea6')} />
        <Testo b={T.b('linea1')} />
      </div>
      <Testo b={T.b('citta')} class="citta" />
    </div>
  </section>

  <section class="section" aria-labelledby="auto-h">
    <div class="wrap split">
      <div>
        <p class="kicker"><Icon name="macchina" size={16} /> In auto</p>
        <h2 id="auto-h">Meglio di no</h2>
        <Testo b={T.b('auto')} />
      </div>
      <div>
        <p class="kicker"><Icon name="nave" size={16} /> In traghetto</p>
        <h2>Dalle isole</h2>
        <Testo b={T.b('isole')} />
      </div>
    </div>
  </section>

  <FontiPagina testi={T} />
</Base>

<style>
  :global(.citta) { margin-top: 1.6rem; }
  :global(.illu-dx) { float: right; width: 90px; height: auto; margin: 0 0 .6rem 1rem; }
  @media (min-width: 760px) { :global(.illu-dx) { width: 140px; } }
</style>
