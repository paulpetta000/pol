---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Testo from '../../components/Testo.astro';
import FontiPagina from '../../components/FontiPagina.astro';
import { getTesti } from '../../lib/testi';

const T = await getTesti('come-vederla');

const MODI = [
  { href: '/come-vederla/dal-lungomare/', icon: 'binocolo', t: 'Dal lungomare, gratis', s: 'Via Caracciolo, Castel dell\'Ovo e le colline' },
  { href: '/come-vederla/dal-mare/', icon: 'barca', t: 'Dal mare', s: 'Con la tua barca o con un\'uscita organizzata' },
  { href: '/come-vederla/biglietti-e-ospitalita/', icon: 'biglietto', t: 'Tribune e ospitalità', s: 'Posti a sedere e pacchetti' },
  { href: '/come-vederla/in-tv-e-streaming/', icon: 'tv', t: 'In TV e in streaming', s: 'Gratis sulla Rai, in chiaro' }
] as const;
---
<Base title="Come vedere l'America's Cup a Napoli" description="Tutti i modi di vedere l'America's Cup 2027 a Napoli a confronto: gratis dal lungomare, dal mare in barca, tribune e ospitalità, in TV e streaming.">
  <PageHead kicker="Vederla" title="Come vedere la Coppa" lead="Quattro modi, dal più semplice al più comodo. Il lungomare è gratis e in prima fila; tribune e pacchetti non sono ancora in vendita." />

  <section class="section">
    <div class="wrap">
      <ul class="vai">
        {MODI.map(m => (
          <li><a href={m.href}>
            <span class="vai__icona"><Icon name={m.icon} /></span>
            <span><span class="vai__titolo">{m.t}</span><span class="vai__sotto">{m.s}</span></span>
            <span class="vai__freccia"><Icon name="freccia" /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="conf-h">
    <div class="wrap">
      <p class="kicker">A confronto</p>
      <h2 id="conf-h">Quale fa per te</h2>
      <div class="grid-2 grid-2--testi">
        {['lungomare', 'mare', 'tribune', 'tv'].map(n => <Testo b={T.b(n)} />)}
      </div>
    </div>
  </section>

  <FontiPagina testi={T} />
</Base>
