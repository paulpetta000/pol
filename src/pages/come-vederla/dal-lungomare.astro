---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Fatti from '../../components/Fatti.astro';
import SpotGruppi from '../../components/SpotGruppi.astro';
import Mappa from '../../components/Mappa.astro';
import Avvisami from '../../components/Avvisami.astro';
import FontiPagina from '../../components/FontiPagina.astro';
import { getCollection } from 'astro:content';
import { getFatti } from '../../lib/fatti';

const ids2027 = ['vista-vicino', 'vista-anfiteatro', 'vil-caracciolo', 'vil-bagnoli', 'vil-bagnoli-gratis', 'vil-caracciolo-gratis', 'vil-formato-stampa', 'vil-due', 'vil-orari-2027', 'ped-2027', 'campo-ovo', 'campo-posillipo', 'campo-mappa-atteso'];
const ids2026 = ['vil-2026-gratis', 'vil-2026-orari', 'vil-2026-show', 'vil-2026-schermi', 'vil-2026-radio', 'ped-2026', 'vil-2026-folla', 'vil-2026-sicurezza', 'campo-2026'];
const idsRegole = ['regole-pubblico-atteso', 'droni-2026', 'caldo-bollettini', 'vento-golfo'];
const f = await getFatti([...ids2027, ...ids2026, ...idsRegole]);
---
<Base title="Vedere l'America's Cup gratis dal lungomare" description="Dove mettersi per vedere gratis le regate dell'America's Cup 2027 a Napoli: via Caracciolo, Rotonda Diaz, Castel dell'Ovo, Monte Echia, via Aniello Falcone, via Orazio e via Petrarca a Posillipo. Sole, gradini, folla e cosa portare.">
  <PageHead illustrazione="binocolo" kicker="Vederla · gratis" title="Dal lungomare" lead="Il campo di regata è a pochi metri dalla riva: dal lungomare vedi gli AC75 passare a tutta velocità, dalle colline tutto il golfo. Qui trovi dove metterti, quando arrivare e cosa portare." crumbs={[{ href: '/come-vederla/', label: 'Vederla' }]} aggiornato="2026-09-30" />

  <section class="section" aria-labelledby="punti-h">
    <div class="wrap">
      <p class="kicker">Dove mi metto?</p>
      <h2 id="punti-h">Undici punti da cui guardare</h2>
      <p>Sul lungomare sei in prima fila; dalle colline e da Posillipo vedi tutto il campo dall'alto. Ogni punto ha la sua fonte, con l'etichetta che dice da dove viene. Il sole, i gradini e la folla sono <strong>valutazioni nostre</strong>, per aiutarti a scegliere: non sono informazioni ufficiali. Il campo 2027 non è ancora disegnato, quindi le distanze sono indicative.</p>
      <Mappa vista="lungomare" id="mappa-lungomare" />
      <SpotGruppi />
    </div>
  </section>

  <section class="section band" aria-labelledby="y27-h">
    <div class="wrap">
      <p class="kicker">2027</p>
      <h2 id="y27-h">Race Village e campo di regata: cosa si sa</h2>
      <Fatti f={f} ids={ids2027} />
    </div>
  </section>

  <section class="section" aria-labelledby="y26-h">
    <div class="wrap">
      <p class="kicker">Il precedente</p>
      <h2 id="y26-h">Com'era a settembre 2026</h2>
      <p class="lead">La regata di prova di Napoli è il modello più vicino a quello che succederà nel 2027.</p>
      <Fatti f={f} ids={ids2026} />
    </div>
  </section>

  <section class="section band" id="cosa-portare" aria-labelledby="porta-h">
    <div class="wrap split">
      <div>
        <p class="kicker">Consigli della guida</p>
        <h2 id="porta-h">Cosa portare</h2>
        <ul class="checklist">
          <li><Icon name="acqua" size={22} /><span><strong>Acqua, tanta.</strong> Tra maggio e luglio sul lungomare non c'è ombra.</span></li>
          <li><Icon name="sole" size={22} /><span><strong>Cappello, crema e occhiali da sole.</strong> Nel pomeriggio si guarda verso il mare, controsole.</span></li>
          <li><Icon name="binocolo" size={22} /><span><strong>Binocolo</strong>, soprattutto se guardi dalle colline.</span></li>
          <li><Icon name="cuffie" size={22} /><span><strong>Telefono carico e cuffie</strong> per seguire il commento in diretta. Porta una batteria esterna: con tanta gente la rete può essere lenta.</span></li>
          <li><Icon name="persone" size={22} /><span><strong>Con i bambini</strong>: decidete prima un punto di ritrovo facile da riconoscere, per esempio un numero della mappa.</span></li>
          <li><Icon name="orologio" size={22} /><span><strong>Arriva presto.</strong> Nel 2026 le pedane si riempivano ben prima delle regate.</span></li>
        </ul>
      </div>
      <div class="stack">
        <h3>Regole e sicurezza</h3>
        <Fatti f={f} ids={idsRegole} />
        <p class="nota">Per il caldo: controlla il bollettino del Ministero della Salute del giorno, e nelle ore più calde cerca l'ombra.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Avvisami titolo="Avvisami quando aprono i villaggi" predefinito={['village', 'calendario']} />
    </div>
  </section>

  <FontiPagina fatti={f.values()} />
</Base>
<style>
  .checklist { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
  .checklist li { display: grid; grid-template-columns: auto 1fr; gap: .8rem; padding: .85rem 0; border-bottom: 1px solid var(--line); margin: 0; }
  .checklist :global(svg) { color: var(--accent); margin-top: .1rem; }
</style>
