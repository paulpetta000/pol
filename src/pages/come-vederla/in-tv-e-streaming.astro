---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Testo from '../../components/Testo.astro';
import FontiPagina from '../../components/FontiPagina.astro';
import { getTesti } from '../../lib/testi';

const T = await getTesti('tv');
---
<Base title="L'America's Cup 2027 in TV e in streaming" description="Dove vedere l'America's Cup 2027 in TV: Rai in chiaro per l'Italia, Sky e NOW a pagamento secondo la stampa, radio ufficiale e canale YouTube. Orari ancora da pubblicare.">
  <PageHead kicker="Vederla · da casa" title="In TV e in streaming" lead="In Italia le regate sono in chiaro sulla Rai; a pagamento, secondo la stampa, su Sky e NOW. Gli orari 2027 non sono ancora usciti." crumbs={[{ href: '/come-vederla/', label: 'Vederla' }]} />
  <section class="section">
    <div class="wrap">
      <h2>Dove vederla</h2>
      <div class="grid-2 grid-2--testi">
        {['rai', 'sky', 'youtube', 'radio'].map(n => <Testo b={T.b(n)} />)}
      </div>
    </div>
  </section>
  <FontiPagina testi={T} />
</Base>
