---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Foto from '../../components/Foto.astro';
import Icon from '../../components/Icon.astro';
import Testo from '../../components/Testo.astro';
import Avvisami from '../../components/Avvisami.astro';
import FontiPagina from '../../components/FontiPagina.astro';
import { getTesti } from '../../lib/testi';

const T = await getTesti('dal-mare');
const breve = T.b('in-breve');
const zone = T.b('zone');
// «Zona rossa» → rossa: il colore del quadratino
const colore = (n: string) => n.toLowerCase().replace('zona ', '');
---
<Base title="Vedere l'America's Cup dal mare" description="Regole per vedere le regate dell'America's Cup a Napoli dalla propria barca: registrazione, zone, 5 nodi, niente ancora, radio VHF. Com'era nel 2026 e cosa manca per il 2027.">
  <PageHead illustrazione="barca" kicker="Vederla · dal mare" title="Dal mare" lead="Con la tua barca puoi stare vicino al campo, ma con regole precise. Quelle del 2027 non sono ancora uscite: qui ci sono quelle del 2026, il modello più probabile." crumbs={[{ href: '/come-vederla/', label: 'Vederla' }]} />

  <section class="section">
    <div class="wrap">
      <Foto id="ac75-partenza-2021" rapporto="21 / 9" class="foto-larga" sizes="(min-width: 1200px) 1150px, calc(100vw - 32px)" widths={[480, 800, 1200]} />
    </div>
    <div class="wrap split" style="margin-top:2rem">
      <div>
        <div class="terzo terzo--wait">
          <p class="kicker" style="color:var(--wait)">2027</p>
          <Testo b={T.b('anno-2027')} />
        </div>
        <h2 class="mt">Le regole del 2026, in breve</h2>
        <Testo b={breve} class="regole-intro" />
        <ol class="regole">
          {breve.voci.map(v => <li><span class="num">{v.num}</span><span set:html={v.html} /></li>)}
        </ol>
      </div>
      <div>
        <h3>Le zone del 2026</h3>
        <ul class="zone">
          {zone.voci.map(v => <li class={`zone__${colore(v.num)}`}><span class="zone__sw" aria-hidden="true"></span><span><strong>{v.num}</strong><br /><span class="muted" set:html={v.html} /></span></li>)}
        </ul>
        <Testo b={zone} class="nota" />
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="det-h">
    <div class="wrap">
      <p class="kicker">Nel dettaglio</p>
      <h2 id="det-h">Le regole del 2026, una per una</h2>
      <Testo b={T.b('dettaglio')} />
    </div>
  </section>

  <section class="section" aria-labelledby="alt-h">
    <div class="wrap">
      <h2 id="alt-h">Traghetti, aliscafi e uscite in barca</h2>
      <Testo b={T.b('traghetti')} />
      <div class="avviso" style="margin-top:1.4rem">
        <Icon name="attenzione" />
        <Testo b={T.b('avviso')} />
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <Avvisami titolo="Avvisami quando escono le regole per le barche" predefinito={['mare']} />
    </div>
  </section>

  <FontiPagina testi={T} />
</Base>
<style>
  .mt { margin-top: 1.8rem; }
  :global(.regole-intro) { margin-bottom: .8rem; }
  .regole { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
  .regole li { display: grid; grid-template-columns: 4.2rem 1fr; gap: .8rem; align-items: baseline; padding: .8rem 0; border-bottom: 1px solid var(--line); margin: 0; }
  .regole .num { color: var(--accent); font-weight: 600; font-size: 1.05rem; }
  .zone { list-style: none; padding: 0; margin: 0 0 1rem; }
  .zone li { display: grid; grid-template-columns: 2.4rem 1fr; gap: .8rem; align-items: start; padding: .7rem 0; border-bottom: 1px solid var(--line); margin: 0; }
  .zone__sw { width: 2.4rem; height: 1.6rem; border-radius: 2px; display: block; }
  .zone__rossa .zone__sw { background: #D64545; }
  .zone__blu .zone__sw { background: #2B6CB0; }
  .zone__grigia .zone__sw { background: repeating-linear-gradient(45deg, #8C9CA6 0 4px, transparent 4px 8px); border: 1px solid #8C9CA6; }
</style>
