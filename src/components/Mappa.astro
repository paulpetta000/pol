---
// Mappa disegnata dai dati OpenStreetMap (src/data/mappa.json), senza servizi esterni:
// funziona anche offline. I punti vengono da src/data/luoghi.yaml.
// Si sposta con un dito (o il mouse), si ingrandisce pizzicando con due dita o con i pulsanti + e −.
// Punti ed etichette restano della stessa grandezza a ogni ingrandimento.
import { getCollection } from 'astro:content';
import { vistaOrdinata, GRUPPI } from '../lib/luoghi';
import M from '../data/mappa.json';

interface Props { vista?: 'panoramica' | 'lungomare' | 'bagnoli'; anteprima?: boolean; id?: string }
const { vista = 'lungomare', anteprima = false, id = 'mappa' } = Astro.props;

const KX = M.w / (M.box.e - M.box.w);
const KY = M.h / (M.box.n - M.box.s);
const P = (lat: number, lon: number) => [Math.round((lon - M.box.w) * KX), Math.round((M.box.n - lat) * KY)] as const;
const poly = (pts: [number, number][]) => 'M' + pts.map(([la, lo]) => P(la, lo).join(' ')).join('L') + 'Z';

// Viste dei pulsanti di zona (x y larghezza altezza, in unità della mappa)
const VISTE = {
  panoramica: `0 0 ${M.w} ${M.h}`,
  lungomare: '960 110 860 760',
  bagnoli: '0 560 900 700'
};

const luoghi = (await getCollection('luoghi')).map(l => ({ ...l, xy: P(l.data.lat, l.data.lon) }));
const viste = (await vistaOrdinata()).map((l, i) => ({ ...l, n: i + 1, xy: P(l.data.lat, l.data.lon) }));
const stazioni = luoghi.filter(l => l.data.tipo === 'stazione' || l.data.tipo === 'porto');
const village = luoghi.filter(l => l.data.tipo === 'village');
const sigla = (linea = '') => linea.startsWith('Funic') ? 'F' : linea.startsWith('Linea 2') ? '2' : linea.startsWith('Cumana') ? 'C' : 'M';

// Campo di regata: zona INDICATIVA davanti al lungomare (la mappa ufficiale 2027 non è ancora uscita)
const campo = poly([[40.8282, 14.2468], [40.8296, 14.2400], [40.8296, 14.2320], [40.8281, 14.2278], [40.8252, 14.2255], [40.8208, 14.2190], [40.8160, 14.2205], [40.8180, 14.2340], [40.8212, 14.2470]]);
const [cx, cy] = P(40.8238, 14.2300);
const caracciolo = M.roadLabels.find(r => r.name === 'Via Francesco Caracciolo');
// Nell'anteprima (senza zoom) i simboli sono un po' più grandi
const kA = anteprima ? ' scale(1.35)' : '';
const zone = M.places.filter(p => !['Pizzofalcone', 'San Ferdinando'].includes(p.name));
---
<figure class:list={['mappa', { 'mappa--anteprima': anteprima }]} id={id} data-mappa={anteprima ? undefined : ''} data-viste={JSON.stringify(VISTE)} data-vista={vista}>
  {!anteprima && (
    <div class="mappa__bar" role="group" aria-label="Zona della mappa">
      <button type="button" data-vista="lungomare" aria-pressed={vista === 'lungomare'}>Lungomare</button>
      <button type="button" data-vista="panoramica" aria-pressed={vista === 'panoramica'}>Tutto il golfo</button>
      <button type="button" data-vista="bagnoli" aria-pressed={vista === 'bagnoli'}>Bagnoli</button>
    </div>
  )}
  <div class="mappa__area">
    <svg viewBox={anteprima ? '940 170 960 600' : VISTE[vista]} role="img" aria-labelledby={`${id}-t`} preserveAspectRatio={anteprima ? 'xMidYMid slice' : 'xMidYMid meet'}>
      <title id={`${id}-t`}>Mappa del lungomare di Napoli con i punti da cui guardare le regate, le stazioni e la zona indicativa del campo di regata</title>
      <defs>
        <pattern id={`${id}-tratteggio`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="14" height="14" fill="var(--accent)" fill-opacity=".10" />
          <line x1="0" y1="0" x2="0" y2="14" stroke="var(--accent)" stroke-width="3" stroke-opacity=".35" />
        </pattern>
      </defs>
      <rect x="0" y="0" width={M.w} height={M.h} fill="var(--map-land)" />
      {!anteprima && <path d={M.parks} fill="var(--map-park)" />}
      <path d={M.sea} fill="var(--map-sea)" stroke="var(--map-sea-line)" stroke-width="2.5" vector-effect="non-scaling-stroke" />
      <path d={M.islands} fill="var(--map-land)" stroke="var(--map-sea-line)" stroke-width="2.5" vector-effect="non-scaling-stroke" />
      {!anteprima && <path d={M.beaches} fill="var(--buoy)" fill-opacity=".35" />}
      <path d={M.piers.areas} fill="var(--line-2)" fill-opacity=".6" />
      <path d={M.piers.lines} fill="none" stroke="var(--line-2)" stroke-width="2.5" />
      {!anteprima && <path d={M.roads[0]} fill="none" stroke="var(--map-road)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />}
      {!anteprima && <path d={M.roads[1]} fill="none" stroke="var(--map-road-casing)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />}
      {!anteprima && <path d={M.roads[1]} fill="none" stroke="var(--map-road)" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />}
      <path d={M.roads[2]} fill="none" stroke="var(--map-road-casing)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" />
      <path d={M.roads[2]} fill="none" stroke="var(--map-road)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />

      <path d={campo} fill={`url(#${id}-tratteggio)`} stroke="var(--accent)" stroke-width="3" stroke-dasharray="12 8" vector-effect="non-scaling-stroke" />
      {caracciolo && <path d={caracciolo.d} fill="none" stroke="var(--accent)" stroke-width="16" stroke-opacity=".45" stroke-linecap="round" />}

      {village.filter(v => v.data.indicativo).map(v => <circle cx={v.xy[0]} cy={v.xy[1]} r="70" fill={`url(#${id}-tratteggio)`} stroke="var(--accent)" stroke-width="3" stroke-dasharray="10 7" vector-effect="non-scaling-stroke" />)}

      {!anteprima && M.roadLabels.filter(r => ['Via Posillipo', 'Via Coroglio'].includes(r.name)).map((r, i) => (
        <>
          <path id={`${id}-rl${i}`} d={r.d} fill="none" />
          <text class="mappa__via"><textPath href={`#${id}-rl${i}`} startOffset="50%" text-anchor="middle">{r.name}</textPath></text>
        </>
      ))}

      {/* Etichette e punti: gruppi "fissi", la grandezza non cambia con lo zoom */}
      {!anteprima && zone.map(p => <g class="mk" transform={`translate(${p.x} ${p.y})`}><text class="mappa__zona" text-anchor="middle">{p.name.toUpperCase()}</text></g>)}
      {!anteprima && <g class="mk" transform={`translate(${cx} ${cy})`}><text class="mappa__lab mappa__lab--campo" text-anchor="middle"><tspan x="0">CAMPO DI REGATA</tspan><tspan x="0" dy="24">zona indicativa</tspan></text></g>}
      {!anteprima && village.map(v => v.id === 'countdown' ? null : (
        <g class="mk" transform={`translate(${v.xy[0]} ${v.xy[1]})`}>
          {v.data.indicativo
            ? <text y="104" class="mappa__lab" text-anchor="middle">Basi e Fan Zone</text>
            : <text y="-44" class="mappa__lab mappa__lab--village" text-anchor="middle">RACE VILLAGE</text>}
        </g>
      ))}

      {stazioni.map(s => {
        const porto = s.data.tipo === 'porto';
        return (
          <g class="mk mappa__staz" transform={`translate(${s.xy[0]} ${s.xy[1]})${kA}`} data-nome={s.data.nome} data-sotto={s.data.linea}>
            <circle r="22" fill="transparent" />
            {porto
              ? <><circle r="11" fill="var(--surface)" stroke="var(--sea)" stroke-width="3.5" /><path d="M0 -6v12M-6 2a6 6 0 0 0 12 0" stroke="var(--sea)" stroke-width="2.5" fill="none" /></>
              : <><rect x="-10" y="-10" width="20" height="20" rx="3" fill="var(--sea)" /><text y="6" text-anchor="middle" class="mappa__m">{sigla(s.data.linea)}</text></>}
          </g>
        );
      })}

      {viste.map(v => (
        <g class:list={['mk', 'mappa__pt', `mappa__pt--${v.data.gruppo}`]} transform={`translate(${v.xy[0]} ${v.xy[1]})${kA}`}
           data-nome={`${v.n}. ${v.data.nome}`} data-sotto={v.data.gruppo ? GRUPPI[v.data.gruppo].nome : ''} data-href={`#luogo-${v.id}`}>
          <circle r="19" class="mappa__pc" stroke="var(--surface)" stroke-width="4" />
          <text y="7.5" text-anchor="middle" class="mappa__n">{v.n}</text>
        </g>
      ))}
    </svg>
    {!anteprima && (
      <>
        <div class="mappa__zoom" role="group" aria-label="Ingrandimento">
          <button type="button" data-zoom="in" aria-label="Ingrandisci">+</button>
          <button type="button" data-zoom="out" aria-label="Rimpicciolisci">−</button>
          <button type="button" data-zoom="reset" aria-label="Torna alla vista iniziale"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v4h4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </div>
        <div class="mappa__pop" hidden>
          <p class="mappa__pop-t"></p>
          <p class="mappa__pop-s"></p>
          <a class="mappa__pop-a" href="#">Apri la scheda ↓</a>
          <button type="button" class="mappa__pop-x" aria-label="Chiudi">×</button>
        </div>
      </>
    )}
  </div>
  {!anteprima && (
    <figcaption class="mappa__leg">
      <span><i class="lg lg--lungomare"></i>Lungomare</span>
      <span><i class="lg lg--colline"></i>Colline</span>
      <span><i class="lg lg--posillipo"></i>Posillipo</span>
      <span><i class="lg lg--m"></i>Metro, treni, funicolari</span>
      <span><i class="lg lg--campo"></i>Campo e villaggi: zone indicative</span>
      <span class="mappa__aiuto">Sposta con un dito, ingrandisci con due dita o con + e −. Tocca un punto per aprire la scheda.</span>
      <span class="mappa__cr">© <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a></span>
    </figcaption>
  )}
</figure>

<script>
  type Box = { x: number; y: number; w: number; h: number };
  const parse = (s: string): Box => { const [x, y, w, h] = s.split(/\s+/).map(Number); return { x, y, w, h }; };

  document.querySelectorAll<HTMLElement>('[data-mappa]').forEach(fig => {
    const svg = fig.querySelector<SVGSVGElement>('.mappa__area > svg')!;
    const viste: Record<string, string> = JSON.parse(fig.dataset.viste || '{}');
    const inizio = fig.dataset.vista || 'lungomare';
    const piena = parse(viste.panoramica);
    const marker = [...svg.querySelectorAll<SVGGElement>('.mk')].map(g => {
      const m = /translate\(([-\d.]+) ([-\d.]+)\)/.exec(g.getAttribute('transform') || '')!;
      return { g, x: +m[1], y: +m[2] };
    });
    const pop = fig.querySelector<HTMLElement>('.mappa__pop')!;
    let box = parse(svg.getAttribute('viewBox')!);

    // Proporzioni reali dell'area: la vista si adatta al riquadro senza deformarsi
    const rapporto = () => { const r = svg.getBoundingClientRect(); return r.width && r.height ? r.width / r.height : 1; };
    const limita = (b: Box): Box => {
      const ar = rapporto();
      let w = Math.min(Math.max(b.w, 220), piena.w * 1.05);
      let h = w / ar;
      if (h > piena.h * 1.05) { h = piena.h * 1.05; w = h * ar; }
      const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
      let x = cx - w / 2, y = cy - h / 2;
      const mx = w * 0.3, my = h * 0.3;
      x = Math.min(Math.max(x, piena.x - mx), piena.x + piena.w - w + mx);
      y = Math.min(Math.max(y, piena.y - my), piena.y + piena.h - h + my);
      return { x, y, w, h };
    };
    const disegna = () => {
      svg.setAttribute('viewBox', `${box.x.toFixed(1)} ${box.y.toFixed(1)} ${box.w.toFixed(1)} ${box.h.toFixed(1)}`);
      // simboli della stessa misura sullo schermo (circa 28 px di diametro) a ogni ingrandimento
      const px = svg.getBoundingClientRect().width || 400;
      const k = Math.min(Math.max((box.w / px) * 0.75, 0.2), 3);
      for (const m of marker) m.g.setAttribute('transform', `translate(${m.x} ${m.y}) scale(${k.toFixed(3)})`);
    };
    const vai = (nome: string) => {
      const v = parse(viste[nome]);
      // allarga la vista richiesta per riempire il riquadro senza tagliare niente
      const ar = rapporto();
      let w = v.w, h = v.h;
      if (w / h < ar) w = h * ar; else h = w / ar;
      box = limita({ x: v.x + v.w / 2 - w / 2, y: v.y + v.h / 2 - h / 2, w, h });
      disegna();
      fig.querySelectorAll('[data-vista]').forEach(x => x instanceof HTMLButtonElement && x.setAttribute('aria-pressed', String(x.dataset.vista === nome)));
      nascondi();
    };
    // Da coordinate dello schermo a coordinate della mappa
    const punto = (cx: number, cy: number) => {
      const r = svg.getBoundingClientRect();
      return { x: box.x + ((cx - r.left) / r.width) * box.w, y: box.y + ((cy - r.top) / r.height) * box.h };
    };
    const zoom = (f: number, cx?: number, cy?: number) => {
      const r = svg.getBoundingClientRect();
      const p = punto(cx ?? r.left + r.width / 2, cy ?? r.top + r.height / 2);
      const nw = box.w * f, nh = box.h * f;
      const fx = (p.x - box.x) / box.w, fy = (p.y - box.y) / box.h;
      box = limita({ x: p.x - fx * nw, y: p.y - fy * nh, w: nw, h: nh });
      disegna();
    };

    function nascondi() { pop.hidden = true; }
    const mostra = (g: SVGGElement) => {
      pop.querySelector('.mappa__pop-t')!.textContent = g.dataset.nome || '';
      pop.querySelector('.mappa__pop-s')!.textContent = g.dataset.sotto || '';
      const a = pop.querySelector<HTMLAnchorElement>('.mappa__pop-a')!;
      const dest = g.dataset.href && document.querySelector(g.dataset.href);
      a.hidden = !dest;
      if (dest) a.href = g.dataset.href!;
      pop.hidden = false;
    };

    // Gesti: un dito sposta, due dita ingrandiscono
    const dita = new Map<number, { x: number; y: number }>();
    let partenza: { x: number; y: number; t: EventTarget | null } | null = null;
    let mosso = false;
    let distanza = 0;
    svg.addEventListener('pointerdown', e => {
      svg.setPointerCapture(e.pointerId);
      dita.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (dita.size === 1) { partenza = { x: e.clientX, y: e.clientY, t: e.target }; mosso = false; }
      if (dita.size === 2) { const [a, b] = [...dita.values()]; distanza = Math.hypot(a.x - b.x, a.y - b.y); mosso = true; }
    });
    svg.addEventListener('pointermove', e => {
      const prima = dita.get(e.pointerId);
      if (!prima) return;
      const ora = { x: e.clientX, y: e.clientY };
      if (dita.size === 1) {
        if (partenza && Math.hypot(ora.x - partenza.x, ora.y - partenza.y) > 6) mosso = true;
        if (mosso) {
          const r = svg.getBoundingClientRect();
          box = limita({ ...box, x: box.x - ((ora.x - prima.x) / r.width) * box.w, y: box.y - ((ora.y - prima.y) / r.height) * box.h });
          disegna();
        }
      }
      dita.set(e.pointerId, ora);
      if (dita.size === 2) {
        const [a, b] = [...dita.values()];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (distanza > 0 && d > 0) zoom(distanza / d, (a.x + b.x) / 2, (a.y + b.y) / 2);
        distanza = d;
      }
    });
    const fine = (e: PointerEvent) => {
      if (dita.size === 1 && !mosso && partenza) {
        const g = (partenza.t as Element | null)?.closest?.('.mappa__pt, .mappa__staz') as SVGGElement | null;
        if (g) mostra(g); else nascondi();
      }
      dita.delete(e.pointerId);
      if (dita.size < 2) distanza = 0;
      if (dita.size === 0) partenza = null;
    };
    svg.addEventListener('pointerup', fine);
    svg.addEventListener('pointercancel', e => { dita.delete(e.pointerId); partenza = null; });
    // Rotella: solo con Ctrl (o il pizzico del trackpad), così la pagina scorre normalmente
    svg.addEventListener('wheel', e => { if (!e.ctrlKey) return; e.preventDefault(); zoom(Math.exp(e.deltaY * 0.01), e.clientX, e.clientY); }, { passive: false });

    fig.querySelectorAll<HTMLButtonElement>('button[data-vista]').forEach(b => b.addEventListener('click', () => vai(b.dataset.vista!)));
    fig.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach(b => b.addEventListener('click', () => {
      const z = b.dataset.zoom;
      if (z === 'in') zoom(0.66); else if (z === 'out') zoom(1.5); else vai(inizio);
    }));
    pop.querySelector('.mappa__pop-x')!.addEventListener('click', nascondi);
    pop.querySelector('.mappa__pop-a')!.addEventListener('click', nascondi);
    let ultimo = rapporto();
    new ResizeObserver(() => { const r = rapporto(); if (Math.abs(r - ultimo) > 0.01) { ultimo = r; box = limita(box); disegna(); } }).observe(svg);
    vai(inizio);
  });
</script>

<style>
  .mappa { margin: 0; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--map-sea); position: relative; }
  .mappa__area { position: relative; }
  .mappa__area > svg { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; max-height: 62vh; }
  .mappa:not(.mappa--anteprima) .mappa__area > svg { touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none; }
  .mappa:not(.mappa--anteprima) .mappa__area > svg:active { cursor: grabbing; }
  @media (min-width: 760px) { .mappa__area > svg { aspect-ratio: 980 / 700; max-height: 70vh; } .mappa:not(.mappa--anteprima) { max-width: 60rem; } }
  .mappa--anteprima .mappa__area > svg { aspect-ratio: 16 / 10; max-height: none; }
  .mappa__bar { display: flex; gap: 0; border-bottom: 1px solid var(--line); background: var(--surface); overflow-x: auto; }
  .mappa__bar button { flex: 1 0 auto; min-height: 44px; padding: .5rem .9rem; border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--ink-2); font: inherit; font-weight: 700; font-stretch: 88%; cursor: pointer; }
  .mappa__bar button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
  .mappa__zoom { position: absolute; right: 10px; top: 10px; display: grid; gap: 6px; }
  .mappa__zoom button { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--line-2); border-radius: var(--r); background: var(--surface); color: var(--ink); font: 700 1.5rem/1 var(--f-sans); cursor: pointer; box-shadow: var(--shadow); }
  .mappa__zoom button:hover { background: var(--ink); color: var(--bg); }
  .mappa__pop { position: absolute; left: 10px; right: 64px; bottom: 10px; background: var(--surface); border: 1px solid var(--line-2); border-left: 5px solid var(--accent); border-radius: var(--r); padding: .6rem 2.6rem .7rem .8rem; box-shadow: var(--shadow); }
  .mappa__pop-t { margin: 0; font-weight: 800; font-stretch: 86%; font-size: 1.1rem; line-height: 1.15; }
  .mappa__pop-s { margin: .1rem 0 .35rem; font-size: .85rem; color: var(--ink-3); }
  .mappa__pop-s:empty { display: none; }
  .mappa__pop-a { font-weight: 700; }
  .mappa__pop-x { position: absolute; top: 2px; right: 2px; width: 44px; height: 44px; border: 0; background: transparent; color: var(--ink-2); font-size: 1.6rem; cursor: pointer; }
  .mappa__via { font: 600 20px var(--f-sans); fill: var(--map-label); paint-order: stroke; stroke: var(--map-land); stroke-width: 5px; letter-spacing: .02em; }
  .mappa__zona { font: 600 20px var(--f-mono); fill: var(--ink-3); letter-spacing: .14em; paint-order: stroke; stroke: var(--map-land); stroke-width: 5px; pointer-events: none; }
  .mappa__lab { font: 800 22px var(--f-sans); font-stretch: 80%; fill: var(--accent); paint-order: stroke; stroke: var(--map-sea); stroke-width: 6px; letter-spacing: .04em; pointer-events: none; }
  .mappa__lab--campo tspan + tspan { font: 500 17px var(--f-mono); fill: var(--ink-2); letter-spacing: .06em; }
  .mappa__lab--village { stroke: var(--map-land); }
  .mappa__n { font: 600 21px var(--f-mono); fill: var(--accent-ink); pointer-events: none; }
  .mappa__pc { fill: var(--accent); }
  .mappa__pt--colline .mappa__pc { fill: var(--sea); }
  .mappa__pt--colline .mappa__n { fill: var(--sea-ink); }
  .mappa__pt--posillipo .mappa__pc { fill: var(--blu); }
  .mappa__pt--posillipo .mappa__n { fill: var(--blu-ink); }
  .mappa__m { font: 700 14px var(--f-sans); fill: #fff; pointer-events: none; }
  .mappa__pt, .mappa__staz { cursor: pointer; }
  .mappa__leg { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; padding: .7rem .9rem; background: var(--surface); border-top: 1px solid var(--line); font-size: .82rem; color: var(--ink-2); }
  .mappa__leg span { display: inline-flex; align-items: center; gap: .4rem; }
  .mappa__aiuto { flex-basis: 100%; color: var(--ink-3); }
  .mappa__cr { margin-left: auto; font-family: var(--f-mono); font-size: .75rem; }
  .lg { display: inline-block; width: 14px; height: 14px; border-radius: 50%; }
  .lg--lungomare { background: var(--accent); }
  .lg--colline { background: var(--sea); }
  .lg--posillipo { background: var(--blu); }
  .lg--m { background: var(--sea); border-radius: 3px; }
  .lg--campo { border-radius: 0; border: 2px dashed var(--accent); background: color-mix(in srgb, var(--accent) 15%, transparent); }
</style>
