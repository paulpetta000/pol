---
// Mappa disegnata dai dati OpenStreetMap (src/data/mappa.json), senza servizi esterni:
// funziona anche offline. I punti vengono da src/data/luoghi.yaml.
import { getCollection } from 'astro:content';
import { vistaOrdinata } from '../lib/luoghi';
import M from '../data/mappa.json';

interface Props { vista?: 'panoramica' | 'lungomare' | 'bagnoli'; anteprima?: boolean; id?: string }
const { vista = 'lungomare', anteprima = false, id = 'mappa' } = Astro.props;

const KX = M.w / (M.box.e - M.box.w);
const KY = M.h / (M.box.n - M.box.s);
const P = (lat: number, lon: number) => [Math.round((lon - M.box.w) * KX), Math.round((M.box.n - lat) * KY)] as const;
const poly = (pts: [number, number][]) => 'M' + pts.map(([la, lo]) => P(la, lo).join(' ')).join('L') + 'Z';

const VISTE = {
  panoramica: `0 0 ${M.w} ${M.h}`,
  lungomare: '860 330 980 700',
  bagnoli: '0 560 900 700'
};

const luoghi = (await getCollection('luoghi')).map(l => ({ ...l, xy: P(l.data.lat, l.data.lon) }));
const P2 = P;
const viste = (await vistaOrdinata()).map(l => ({ ...l, xy: P2(l.data.lat, l.data.lon) }));
const stazioni = luoghi.filter(l => l.data.tipo === 'stazione' || l.data.tipo === 'porto');
const village = luoghi.filter(l => l.data.tipo === 'village');

// Campo di regata: zona INDICATIVA davanti al lungomare (la mappa ufficiale 2027 non è ancora uscita)
const campo = poly([[40.8282, 14.2468], [40.8296, 14.2400], [40.8296, 14.2320], [40.8281, 14.2278], [40.8252, 14.2255], [40.8208, 14.2190], [40.8160, 14.2205], [40.8180, 14.2340], [40.8212, 14.2470]]);
const caracciolo = M.roadLabels.find(r => r.name === 'Via Francesco Caracciolo');
const numero = new Map(viste.map((v, i) => [v.id, i + 1]));
---
<figure class:list={['mappa', { 'mappa--anteprima': anteprima }]} id={id} data-mappa data-viste={JSON.stringify(VISTE)}>
  {!anteprima && (
    <div class="mappa__bar" role="group" aria-label="Zona della mappa">
      <button type="button" data-vista="lungomare" aria-pressed={vista === 'lungomare'}>Lungomare</button>
      <button type="button" data-vista="panoramica" aria-pressed={vista === 'panoramica'}>Tutto il golfo</button>
      <button type="button" data-vista="bagnoli" aria-pressed={vista === 'bagnoli'}>Bagnoli</button>
    </div>
  )}
  <svg viewBox={VISTE[vista]} role="img" aria-labelledby={`${id}-t`} preserveAspectRatio="xMidYMid slice">
    <title id={`${id}-t`}>Mappa del lungomare di Napoli con i punti da cui guardare le regate, le stazioni e la zona indicativa del campo di regata</title>
    <defs>
      <pattern id={`${id}-tratteggio`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="14" height="14" fill="var(--accent)" fill-opacity=".10" />
        <line x1="0" y1="0" x2="0" y2="14" stroke="var(--accent)" stroke-width="3" stroke-opacity=".35" />
      </pattern>
    </defs>
    <rect x="0" y="0" width={M.w} height={M.h} fill="var(--map-land)" />
    {!anteprima && <path d={M.parks} fill="var(--map-park)" />}
    <path d={M.sea} fill="var(--map-sea)" stroke="var(--map-sea-line)" stroke-width="2.5" />
    <path d={M.islands} fill="var(--map-land)" stroke="var(--map-sea-line)" stroke-width="2.5" />
    {!anteprima && <path d={M.beaches} fill="var(--buoy)" fill-opacity=".35" />}
    <path d={M.piers.areas} fill="var(--line-2)" fill-opacity=".6" />
    <path d={M.piers.lines} fill="none" stroke="var(--line-2)" stroke-width="2.5" />
    {!anteprima && <path d={M.roads[0]} fill="none" stroke="var(--map-road)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />}
    {!anteprima && <path d={M.roads[1]} fill="none" stroke="var(--map-road-casing)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />}
    {!anteprima && <path d={M.roads[1]} fill="none" stroke="var(--map-road)" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />}
    <path d={M.roads[2]} fill="none" stroke="var(--map-road-casing)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" />
    <path d={M.roads[2]} fill="none" stroke="var(--map-road)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />

    <g class="mappa__campo">
      <path d={campo} fill={`url(#${id}-tratteggio)`} stroke="var(--accent)" stroke-width="3" stroke-dasharray="12 8" />
      {!anteprima && (() => { const [x, y] = P(40.8238, 14.2300); return (
        <text x={x} y={y} class="mappa__lab mappa__lab--campo" text-anchor="middle">
          <tspan x={x}>CAMPO DI REGATA</tspan><tspan x={x} dy="26">zona indicativa</tspan>
        </text>); })()}
    </g>

    {caracciolo && <path d={caracciolo.d} fill="none" stroke="var(--accent)" stroke-width="16" stroke-opacity=".45" stroke-linecap="round" />}

    {!anteprima && M.roadLabels.filter(r => ['Via Posillipo', 'Via Coroglio'].includes(r.name)).map((r, i) => (
      <>
        <path id={`${id}-rl${i}`} d={r.d} fill="none" />
        <text class="mappa__via"><textPath href={`#${id}-rl${i}`} startOffset="50%" text-anchor="middle">{r.name}</textPath></text>
      </>
    ))}
    {!anteprima && M.places.filter(p => !['Pizzofalcone', 'San Ferdinando'].includes(p.name)).map(p => <text x={p.x} y={p.y} class="mappa__zona" text-anchor="middle">{p.name.toUpperCase()}</text>)}

    {village.map(v => {
      const [x, y] = v.xy;
      return v.data.indicativo
        ? <g><circle cx={x} cy={y} r="70" fill={`url(#${id}-tratteggio)`} stroke="var(--accent)" stroke-width="3" stroke-dasharray="10 7" />{!anteprima && <text x={x} y={y + 105} class="mappa__lab" text-anchor="middle">Basi e Fan Zone</text>}</g>
        : v.id === 'countdown' ? null
        : !anteprima && <text x={x} y={y - 48} class="mappa__lab mappa__lab--village" text-anchor="middle">RACE VILLAGE</text>;
    })}

    {stazioni.map(s => {
      const [x, y] = s.xy;
      const porto = s.data.tipo === 'porto';
      return (
        <g class="mappa__staz">
          <title>{s.data.nome} · {s.data.linea}</title>
          {porto
            ? <><circle cx={x} cy={y} r="11" fill="var(--surface)" stroke="var(--sea)" stroke-width="3.5" /><path d={`M${x} ${y - 6}v12M${x - 6} ${y + 2}a6 6 0 0 0 12 0`} stroke="var(--sea)" stroke-width="2.5" fill="none" /></>
            : <><rect x={x - 10} y={y - 10} width="20" height="20" rx="3" fill="var(--sea)" /><text x={x} y={y + 6} text-anchor="middle" class="mappa__m">{s.data.linea?.startsWith('Funic') ? 'F' : s.data.linea?.startsWith('Linea 2') ? '2' : s.data.linea?.startsWith('Cumana') ? 'C' : 'M'}</text></>}
        </g>
      );
    })}

    {viste.map(v => {
      const [x, y] = v.xy;
      const n = numero.get(v.id);
      return (
        anteprima
          ? <g><circle cx={x} cy={y} r="19" fill="var(--accent)" stroke="var(--surface)" stroke-width="4" /><text x={x} y={y + 7.5} text-anchor="middle" class="mappa__n">{n}</text></g>
          : <a href={`#luogo-${v.id}`} class="mappa__pt" aria-label={`${n}. ${v.data.nome}`}>
              <circle cx={x} cy={y} r="19" fill="var(--accent)" stroke="var(--surface)" stroke-width="4" />
              <text x={x} y={y + 7.5} text-anchor="middle" class="mappa__n">{n}</text>
            </a>
      );
    })}
  </svg>
  {!anteprima && (
    <figcaption class="mappa__leg">
      <span><i class="lg lg--pt"></i>Punti da cui guardare</span>
      <span><i class="lg lg--m"></i>Metro, treni, funicolari</span>
      <span><i class="lg lg--porto"></i>Porti</span>
      <span><i class="lg lg--campo"></i>Campo e villaggi: zone indicative</span>
      <span class="mappa__cr">© <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a></span>
    </figcaption>
  )}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-mappa]').forEach(fig => {
    const svg = fig.querySelector('svg')!;
    const viste = JSON.parse(fig.dataset.viste || '{}');
    fig.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach(b => b.addEventListener('click', () => {
      svg.setAttribute('viewBox', viste[b.dataset.vista!]);
      fig.querySelectorAll('[data-vista]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    }));
  });
</script>

<style>
  .mappa { margin: 0; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--map-sea); position: relative; }
  .mappa svg { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; max-height: 76vh; }
  @media (min-width: 760px) { .mappa svg { aspect-ratio: 980 / 700; max-height: none; } .mappa:not(.mappa--anteprima) { max-width: 60rem; } }
  .mappa--anteprima svg { aspect-ratio: 16 / 10; }
  .mappa__bar { display: flex; gap: 0; border-bottom: 1px solid var(--line); background: var(--surface); overflow-x: auto; }
  .mappa__bar button { flex: 1 0 auto; min-height: 44px; padding: .5rem .9rem; border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--ink-2); font: inherit; font-weight: 700; font-stretch: 88%; cursor: pointer; }
  .mappa__bar button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
  .mappa__via { font: 600 20px var(--f-sans); fill: var(--map-label); paint-order: stroke; stroke: var(--map-land); stroke-width: 5px; letter-spacing: .02em; }
  .mappa__zona { font: 600 22px var(--f-mono); fill: var(--ink-3); letter-spacing: .14em; paint-order: stroke; stroke: var(--map-land); stroke-width: 5px; }
  .mappa__lab { font: 800 24px var(--f-sans); font-stretch: 80%; fill: var(--accent); paint-order: stroke; stroke: var(--map-sea); stroke-width: 6px; letter-spacing: .04em; }
  .mappa__lab--campo tspan + tspan { font: 500 18px var(--f-mono); fill: var(--ink-2); letter-spacing: .06em; }
  .mappa__lab--village { stroke: var(--map-land); }
  .mappa__n { font: 600 21px var(--f-mono); fill: var(--accent-ink); pointer-events: none; }
  .mappa__m { font: 700 14px var(--f-sans); fill: #fff; pointer-events: none; }
  .mappa__pt { cursor: pointer; }
  .mappa__pt:hover circle, .mappa__pt:focus circle { fill: var(--ink); }
  .mappa__leg { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; padding: .7rem .9rem; background: var(--surface); border-top: 1px solid var(--line); font-size: .82rem; color: var(--ink-2); }
  .mappa__leg span { display: inline-flex; align-items: center; gap: .4rem; }
  .mappa__cr { margin-left: auto; font-family: var(--f-mono); font-size: .72rem; }
  .lg { display: inline-block; width: 14px; height: 14px; }
  .lg--pt { background: var(--accent); border-radius: 50%; }
  .lg--m { background: var(--sea); border-radius: 3px; }
  .lg--porto { border: 3px solid var(--sea); border-radius: 50%; }
  .lg--campo { border: 2px dashed var(--accent); background: color-mix(in srgb, var(--accent) 15%, transparent); }
</style>
