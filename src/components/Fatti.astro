---
// Elenco di schede con stato e fonte
import Fatto from './Fatto.astro';
import type { Fatto as F } from '../lib/fatti';
interface Props { f: Map<string, F>; ids: string[] }
const { f, ids } = Astro.props;
---
<ul class="fatti">
  {ids.map(id => { const x = f.get(id); if (!x) throw new Error(`Scheda ${id} non caricata`); return <Fatto f={x} />; })}
</ul>
