---
// Scheda "Dove mi metto?": un punto da cui guardare, con la valutazione della guida
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { l: CollectionEntry<'luoghi'>; n: number }
const { l, n } = Astro.props;
const d = l.data;
const VICINO = { 'prima-fila': 'In prima fila', vicino: 'Vicino', 'dall-alto': 'Dall\'alto' } as const;
const staz = await Promise.all(d.arrivare.map(r => getEntry('luoghi', r.id)));
---
<article class="spot" id={`luogo-${l.id}`}>
  <header class="spot__head">
    <span class="spot__n num" aria-hidden="true">{n}</span>
    <div>
      <h3 class="spot__h">{d.nome}</h3>
      <p class="spot__z mono">{d.zona}{d.vicino && <> · <span class="spot__v">{VICINO[d.vicino]}</span></>}</p>
    </div>
  </header>
  {d.testo && <p class="spot__t">{d.testo}</p>}
  <dl class="righe spot__righe">
    {d.visuale && <><dt><Icon name="binocolo" size={16} /> Cosa vedi</dt><dd>{d.visuale}</dd></>}
    {d.sole && <><dt><Icon name="sole" size={16} /> Sole</dt><dd>{d.sole}</dd></>}
    {d.gradini && <><dt><Icon name="scale" size={16} /> Gradini</dt><dd>{d.gradini}</dd></>}
    {d.folla && <><dt><Icon name="persone" size={16} /> Folla</dt><dd>{d.folla}</dd></>}
    {d.servizi && <><dt><Icon name="info" size={16} /> Servizi</dt><dd>{d.servizi}</dd></>}
    {staz.length > 0 && <><dt><Icon name="treno" size={16} /> Fermate</dt><dd>{staz.filter(Boolean).map(s => `${s!.data.nome} (${s!.data.linea})`).join(' · ')}</dd></>}
  </dl>
</article>
<style>
  .spot { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 1rem 1rem .4rem; scroll-margin-top: calc(var(--head-h) + 16px); }
  .spot:target { outline: 3px solid var(--accent); outline-offset: 2px; }
  .spot__head { display: grid; grid-template-columns: auto 1fr; gap: .8rem; align-items: center; margin-bottom: .6rem; }
  .spot__n { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: 1.1rem; font-weight: 600; }
  .spot__h { margin: 0; font-size: 1.25rem; }
  .spot__z { margin: .2rem 0 0; font-size: .74rem; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); }
  .spot__v { color: var(--accent); font-weight: 600; }
  .spot__t { color: var(--ink-2); }
  .spot__righe { grid-template-columns: minmax(6.8rem, max-content) 1fr; font-size: .94rem; }
  .spot__righe dt { display: flex; gap: .35rem; align-items: center; }
  .spot__righe > :nth-last-child(-n+2) { border-bottom: 0; }
</style>
