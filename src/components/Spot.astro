---
// Scheda "Dove mi metto?": un punto da cui guardare, con foto, un breve testo (src/testi/punti.yaml)
// e la valutazione della guida (sole, gradini, folla: stime nostre, da src/data/luoghi.yaml).
// Le fonti del testo finiscono in fondo alla pagina: la pagina passa getTesti('punti') a FontiPagina.
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import Testo from './Testo.astro';
import { getTesti } from '../lib/testi';
import { GRUPPI } from '../lib/luoghi';
interface Props { l: CollectionEntry<'luoghi'>; n: number; livello?: 'h3' | 'h4' }
const { l, n, livello = 'h3' } = Astro.props;
const H = livello;
const d = l.data;
const VICINO = { 'prima-fila': 'In prima fila', vicino: 'Vicino', 'dall-alto': 'Dall\'alto' } as const;
const staz = (await Promise.all(d.arrivare.map(r => getEntry('luoghi', r.id)))).filter(Boolean);
const b = (await getTesti('punti')).b(l.id);
// Il testo deve usare la scheda che spiega perché il punto è in elenco, e le altre del punto
const manca = [d.perche, ...d.fatti].filter(r => r && !b.fatti.some(x => x.id === r.id)).map(r => r!.id);
if (manca.length) throw new Error(`src/testi/punti.yaml#${l.id}: il testo deve usare anche ${manca.join(', ')} (vedi src/data/luoghi.yaml)`);
const gruppo = d.gruppo ? GRUPPI[d.gruppo] : null;
---
<article class:list={['spot', d.gruppo && `spot--${d.gruppo}`]} id={`luogo-${l.id}`}>
  {d.foto && <Foto id={d.foto.id} rapporto="3 / 2" class="spot__foto" />}
  <header class="spot__head">
    <span class="spot__n num" aria-hidden="true">{n}</span>
    <div>
      <H class="spot__h"><span class="visually-hidden">{n}. </span>{d.nome}</H>
      <p class="spot__z mono">{gruppo ? gruppo.nome : d.zona}{d.zona && gruppo && d.zona !== gruppo.nome && <> · {d.zona}</>}{d.vicino && <> · <span class="spot__v">{VICINO[d.vicino]}</span></>}</p>
    </div>
  </header>
  <Testo b={b} class="spot__t" />
  <dl class="righe spot__righe">
    {d.visuale && <><dt><Icon name="binocolo" size={16} /> Cosa vedi</dt><dd>{d.visuale}</dd></>}
    {d.sole && <><dt><Icon name="sole" size={16} /> Sole</dt><dd>{d.sole}</dd></>}
    {d.gradini && <><dt><Icon name="scale" size={16} /> Gradini</dt><dd>{d.gradini}</dd></>}
    {d.folla && <><dt><Icon name="persone" size={16} /> Folla</dt><dd>{d.folla}</dd></>}
    {d.servizi && <><dt><Icon name="info" size={16} /> Servizi</dt><dd>{d.servizi}</dd></>}
    {staz.length > 0 && <><dt><Icon name="treno" size={16} /> Fermate</dt><dd>{staz.map(s => `${s!.data.nome} (${s!.data.linea})`).join(' · ')}</dd></>}
  </dl>
</article>
<style>
  .spot { --g: var(--accent); --g-ink: var(--accent-ink); background: var(--surface); border: 1px solid var(--line); border-top: 5px solid var(--g); border-radius: var(--r); padding: 1rem 1rem .6rem; scroll-margin-top: calc(var(--head-h) + 16px); }
  .spot--colline { --g: var(--sea); --g-ink: var(--sea-ink); }
  .spot--posillipo { --g: var(--blu); --g-ink: var(--blu-ink); }
  .spot:target { outline: 3px solid var(--g); outline-offset: 2px; }
  .spot :global(.spot__foto) { margin: -.2rem 0 .9rem; }
  .spot__head { display: grid; grid-template-columns: auto 1fr; gap: .8rem; align-items: center; margin-bottom: .5rem; }
  .spot__n { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--g); color: var(--g-ink); font-size: 1.1rem; font-weight: 600; }
  .spot__h { margin: 0; font-size: 1.25rem; }
  .spot__z { margin: .2rem 0 0; font-size: .75rem; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); }
  .spot__v { color: var(--ink); font-weight: 600; }
  .spot :global(.spot__t) { color: var(--ink-2); margin-bottom: .9rem; }
  .spot :global(.spot__t p) { margin: 0 0 .6em; }
  .spot__righe { grid-template-columns: minmax(6.8rem, max-content) 1fr; font-size: .94rem; }
  .spot__righe dt { display: flex; gap: .35rem; align-items: center; }
  .spot__righe > :nth-last-child(-n+2) { border-bottom: 0; }
</style>
