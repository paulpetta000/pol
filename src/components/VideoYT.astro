---
// Video del canale ufficiale. Prima del tocco c'è solo una copertina disegnata da noi:
// YouTube non riceve nulla. Al tocco parte il lettore in modalità privacy avanzata (youtube-nocookie.com).
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { v: CollectionEntry<'video'>; titoloTag?: 'h2' | 'h3' }
const { v, titoloTag = 'h3' } = Astro.props;
const { titolo, originale, durata, gruppo, quando, perche } = v.data;
const H = titoloTag;
const KICK = { capire: 'Capire', regate: 'Regata', storia: 'Storia' } as const;
// Piccole variazioni della copertina, sempre uguali per lo stesso video
const seme = [...v.id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const dx = 70 + (seme % 90);
const verso = seme % 2 ? 1 : -1;
const onde = Array.from({ length: 5 }, (_, i) => 128 + i * 10);
const barca = (x: number, y: number, s: number, col: string, dir: number) =>
  `<g transform="translate(${x} ${y}) scale(${s * dir} ${s})">
    <path d="M-50 4 L-47 26 M-56 26 H-38" stroke="#EDF3F5" stroke-width="2.4" fill="none" stroke-linecap="round"/>
    <path d="M6 0 L10 30 M-2 32 H22" stroke="#EDF3F5" stroke-width="2.6" fill="none" stroke-linecap="round"/>
    <path d="M-52 0 L50 -4 L46 -10 L-48 -12 Z" fill="${col}"/>
    <path d="M-6 -13 L-11 -86 L-40 -15 Z" fill="#EDF3F5" opacity=".92"/>
    <path d="M-3 -13 L-7 -70 L34 -12 Z" fill="#EDF3F5" opacity=".7"/>
    <path d="M-6 -12 L-11 -88" stroke="#0D2440" stroke-width="1.6"/>
  </g>`;
let disegno = '';
if (gruppo === 'capire') disegno = barca(dx + 70, 112, 1, '#FF7A3D', verso);
else if (gruppo === 'regate') disegno = barca(dx + 20, 116, 0.8, '#2CC4D8', verso) + barca(dx + 150, 106, 1, '#FF7A3D', verso);
else disegno = `<g transform="translate(${dx + 90} 26)" fill="#FFD84D">
    <path d="M-30 6 H30 C30 30 18 44 6 50 V78 H20 V88 H-20 V78 H-6 V50 C-18 44 -30 30 -30 6 Z"/>
    <path d="M30 12 C48 12 48 38 22 42" stroke="#FFD84D" stroke-width="5" fill="none"/>
    <path d="M-30 12 C-48 12 -48 38 -22 42" stroke="#FFD84D" stroke-width="5" fill="none"/>
    <rect x="-26" y="88" width="52" height="10" rx="2"/>
  </g>`;
const url = `https://www.youtube.com/watch?v=${v.id}`;
---
<figure class="vid" data-vid={v.id} data-titolo={titolo}>
  <div class="vid__box">
    <button type="button" class="vid__play" aria-label={`Guarda il video «${titolo}», ${durata}. Si apre il lettore di YouTube`}>
      <svg class="vid__poster" viewBox="0 0 320 180" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
        <rect width="320" height="180" fill="#0D2440" />
        <rect y="118" width="320" height="62" fill="#0B2A30" />
        {onde.map((y, i) => <path d={`M0 ${y} q20 -4 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0`} fill="none" stroke="#2CC4D8" stroke-width="1.2" opacity={0.18 + i * 0.06} />)}
        <line x1="0" y1="118" x2="320" y2="118" stroke="#2CC4D8" stroke-width="2" />
        <Fragment set:html={disegno} />
        <text x="16" y="26" fill="#FF7A3D" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.5">{KICK[gruppo].toUpperCase()}</text>
      </svg>
      <span class="vid__tasto"><Icon name="play" size={30} /></span>
      <span class="vid__durata mono">{durata}</span>
    </button>
  </div>
  <figcaption class="vid__cap">
    <H class="vid__t">{titolo}</H>
    <p class="vid__p">{perche}</p>
    <p class="vid__meta small">{quando} · <span lang="en">«{originale}»</span> · <a href={url} rel="noopener">Apri su YouTube<Icon name="esterno" size={14} /></a></p>
  </figcaption>
</figure>

<script>
  // Al tocco la copertina diventa il lettore ufficiale (senza cookie finché non si preme play dentro YouTube)
  document.querySelectorAll<HTMLElement>('[data-vid]').forEach(fig => {
    const btn = fig.querySelector<HTMLButtonElement>('.vid__play');
    btn?.addEventListener('click', () => {
      const id = fig.dataset.vid!;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&playsinline=1`;
      f.title = `Video: ${fig.dataset.titolo}`;
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.className = 'vid__frame';
      btn.replaceWith(f);
      f.focus();
    });
  });
</script>

<style>
  .vid { margin: 0; display: flex; flex-direction: column; gap: .7rem; }
  .vid__box { position: relative; aspect-ratio: 16 / 9; border-radius: var(--r); overflow: hidden; background: #0D2440; border: 1px solid var(--line); }
  .vid__play { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; display: block; }
  .vid__poster { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .vid__tasto { position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%); width: 64px; height: 64px; display: grid; place-items: center; border-radius: 50%; background: #FF7A3D; color: #1A0B03; box-shadow: 0 6px 20px -6px rgba(0, 0, 0, .7); transition: transform .15s; }
  .vid__tasto :global(svg) { margin-left: 3px; }
  .vid__play:hover .vid__tasto, .vid__play:focus-visible .vid__tasto { transform: translate(-50%, -50%) scale(1.08); }
  .vid__play:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .vid__durata { position: absolute; right: 10px; bottom: 10px; background: #FFD84D; color: #0F1519; font-size: .8rem; font-weight: 600; padding: .1rem .45rem; border-radius: 2px; }
  .vid__box :global(.vid__frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vid__t { font-size: 1.2rem; margin: 0; }
  .vid__p { margin: 0; color: var(--ink-2); }
  .vid__meta { margin: 0; color: var(--ink-3); }
  .vid__meta a { display: inline-flex; align-items: center; gap: .25rem; white-space: nowrap; }
</style>
