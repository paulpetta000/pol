{
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    { "source": "/live.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
